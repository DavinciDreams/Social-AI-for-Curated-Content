# NPM Configuration for Social AI for Curated Content Monorepo

# Workspace settings
workspaces=true

# Install hoisting - hoist dependencies to the root when possible
hoist=true

# Public hoist - hoist specific packages to the root even if they are not used by all workspaces
# This is useful for development tools like TypeScript, ESLint, etc.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*typescript*
public-hoist-pattern[]=*jest*

# Save exact versions
save-exact=false

# Engine strict - enforce engine versions from package.json
engine-strict=true

# Log level
loglevel=warn

# Progress display
progress=false

# Fund message
fund=false

# Audit level
audit-level=moderate

# Registry (uncomment to use a specific registry)
# registry=https://registry.npmjs.org/
